# Native FastAPI + Neon configuration (no Docker)
ENVIRONMENT=development
APP_DEBUG=false

# Copy the pooled Neon connection string and keep TLS enabled. SQLAlchemy
# normalizes postgresql:// to postgresql+asyncpg:// at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Optional direct endpoint for Alembic; omit to use DATABASE_URL.
# DATABASE_MIGRATION_URL=postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_RECYCLE_SECONDS=300

# Generate a unique value with at least 32 random characters.
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_ISSUER=capacity-aware-aml-triage
JWT_AUDIENCE=capacity-aware-aml-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

CORS_ORIGINS=http://localhost:5173
MODEL_ARTIFACT_DIR=artifacts/models/sprint2-lightgbm
